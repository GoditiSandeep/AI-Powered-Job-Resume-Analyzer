# Application Settings
PROJECT_NAME="AI Powered Job & Resume Analyzer"
PROJECT_OWNER="Godithi Kiran Sri Sai Sandeep"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Replace these placeholders in your private, ignored backend/.env file.
ADMIN_USERNAME=Godithi Sandeep
ADMIN_EMAIL=admin@analyzer.local
ADMIN_PASSWORD=CHANGE_THIS_LOCALLY
DEMO_USER_EMAIL=demo@analyzer.local
DEMO_USER_PASSWORD=CHANGE_THIS_LOCALLY

# JWT Security
JWT_SECRET=CHANGE_THIS_LOCALLY_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./app/database/job_resume_analyzer.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/job_resume_analyzer

# AI Configuration (Optional OpenAI-compatible LLM Provider)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=["pdf","docx","doc","txt"]

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","http://127.0.0.1:3000"]
